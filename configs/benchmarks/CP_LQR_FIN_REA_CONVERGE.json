{
  "$schema": "../schema/benchmark.schema.json",
  "id": "CP_LQR_FIN_REA_CONVERGE",
  "description": "Cart-pole with LQR feedback (4D), finite horizon: the state converges into a small box around the upright equilibrium.",
  "notes": ["The initial set is a single state (degenerate box).", "State x = (p, v, theta, omega): cart position and velocity, pole angle and angular velocity. u = -K x is the LQR state feedback (gains k1..k4); with these parameters the equations equal the previous inline form."],
  "system": {
    "type": "nonlinear",
    "parameters": {
      "m_c": 3,
      "m_p": 2,
      "l": 1,
      "g": 9.8065,
      "k1": 3.16227766016837,
      "k2": 6.69810360685677,
      "k3": 5.02657663490373,
      "k4": 1.6165296244068
    },
    "definitions": {
      "u": "-(k1*x1 + k2*x2 + k3*x3 + k4*x4)"
    },
    "equations": ["x2", "(u + m_p*sin(x3)*(l*x4^2 - g*cos(x3)))/(m_c + m_p*sin(x3)^2)", "x4", "(u*cos(x3) + m_p*l*x4^2*sin(x3)*cos(x3) - (m_c + m_p)*g*sin(x3))/(l*(m_c + m_p*sin(x3)^2))"]
  },
  "domain": [
    [-5.0, 5.0],
    [-5.0, 5.0],
    [-3.14159, 3.14159],
    [-10.0, 10.0]
  ],
  "initial_sets": [
    {
      "type": "box",
      "bounds": [
        [0.8, 0.8],
        [0.3, 0.3],
        [-0.785398, -0.785398],
        [0.2, 0.2]
      ]
    }
  ],
  "target_sets": [
    {
      "type": "box",
      "bounds": [
        [-0.001, 0.001],
        [-0.001, 0.001],
        [-0.001, 0.001],
        [-0.001, 0.001]
      ]
    }
  ],
  "time_horizon": [0.0, 12.0],
  "expected_result": "reachable",
  "visualization": {
    "dims": [
      [0, 1],
      [2, 3]
    ]
  }
}
