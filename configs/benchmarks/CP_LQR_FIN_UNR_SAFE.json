{
  "$schema": "../schema/benchmark.schema.json",
  "id": "CP_LQR_FIN_UNR_SAFE",
  "description": "Cart-pole with LQR feedback (4D), finite horizon: the pole-tip coordinate x1 + sin(x3) never reaches 1.7 inside the box [-1,1]^3 x [-2.5,2.5].",
  "notes": [
    "The initial set is a single state (degenerate box).",
    "The target is restricted to the box [-1,1]^3 x [-2.5,2.5], which lies in the basin of attraction of the LQR equilibrium (needed by eigenfunction-based methods); the unrestricted pole-tip region extends to states that do not converge."
  ],
  "system": {
    "type": "nonlinear",
    "equations": ["x2", "(-3.16227766016837*x1 - 6.69810360685677*x2 - 5.02657663490373*x3 - 1.6165296244068*x4 + 2*(x4^2 - 9.8065*cos(x3))*sin(x3))/(2*sin(x3)^2 + 3)", "x4", "(2*x4^2*sin(x3)*cos(x3) + (-3.16227766016837*x1 - 6.69810360685677*x2 - 5.02657663490373*x3 - 1.6165296244068*x4)*cos(x3) - 49.0325*sin(x3))/(2*sin(x3)^2 + 3)"]
  },
  "domain": [
    [-5.0, 5.0],
    [-5.0, 5.0],
    [-3.14159, 3.14159],
    [-10.0, 10.0]
  ],
  "initial_sets": [
    {
      "type": "box",
      "bounds": [
        [0.8, 0.8],
        [0.3, 0.3],
        [-0.785398, -0.785398],
        [0.2, 0.2]
      ]
    }
  ],
  "target_sets": [
    {
      "type": "level_set",
      "function": "1.7 - x1 - sin(x3)",
      "bounding_box": [
        [-1, 1],
        [-1, 1],
        [-1, 1],
        [-2.5, 2.5]
      ]
    }
  ],
  "time_horizon": [0.0, 10.0],
  "expected_result": "unreachable",
  "visualization": {
    "dims": [
      [0, 1],
      [2, 3]
    ]
  }
}
